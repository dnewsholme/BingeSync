# ==============================================================================
# BingeSync Environment Configuration
# ==============================================================================

# Server network settings
HOST=0.0.0.0
PORT=8080

# Public base URL of your BingeSync installation (used for generating Plex webhook URLs and OIDC callbacks)
APP_URL=http://localhost:8080

# SQLite Database connection string (use WAL mode for performance)
DATABASE_URL=sqlite:///data/bingesync.db?mode=rwc

# Secret key used for signing JWT session tokens
JWT_SECRET=replace-with-a-random-32-character-secret-in-production

# ==============================================================================
# OpenID Connect (OIDC) Authentication
# Supported providers: Authentik, PocketID, Keycloak, Authelia, Okta, Google, etc.
# Scopes requested: "openid email profile groups"
# Users in groups: admin, admins, administrator, administrators are granted admin role.
# Backchannel logout URL: ${APP_URL}/api/v1/auth/backchannel-logout
# ==============================================================================
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=bingesync
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback

# Enable/disable local dev sign-in form.
# Defaults to true when OIDC_ENABLED is false. Set to false to enforce OIDC login only.
DEV_LOGIN_ENABLED=true

# Optional reverse proxy subpath mount (e.g. /bingesync for www.example.com/bingesync)
BASE_PATH=

# Note: Radarr, Sonarr, and Tautulli integrations are configured per-user
# directly in the BingeSync Settings UI (Settings > Connected Services).

# ==============================================================================
# TheTVDB Metadata Integration (Optional)
# Enables background enrichment of genres, cast/actors, directors, and plot summaries
# ==============================================================================
TVDB_API_KEY=your-thetvdb-v4-api-key
# TVDB_PIN=your-subscriber-pin  # Only required if using a user-subscription key
TVDB_BASE_URL=https://api4.thetvdb.com/v4

# ==============================================================================
# Playback & Scrobble Progress (Optional)
# Percentage of media watched to mark as completed (default: 80)
# ==============================================================================
SCROBBLE_THRESHOLD_PERCENT=80

# ==============================================================================
# Tautulli Import Integration (Optional)
# Enables importing watch history directly from your Tautulli instance
# ==============================================================================
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=your-tautulli-api-key

# ==============================================================================
# Image Poster Cache (Optional)
# Directory where downloaded media poster images are cached locally on disk
# ==============================================================================
IMAGE_CACHE_DIR=/data/images


